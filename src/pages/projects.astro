---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/projects';
---
<Layout title="Projects">
  <h1>Projects</h1>
  <div class="projects">{projects.map(project => <details class="project">
    <summary><span>{project.title}</span><span class="project-year">{project.year}</span></summary>
    <div class="project-detail"><p>{project.description}</p><div class="project-meta">{project.url && <a href={project.url}>Visit ↗</a>}{project.repo && <a href={project.repo}>Source ↗</a>}</div></div>
  </details>)}</div>
</Layout>
