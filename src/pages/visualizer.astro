---
import { loadActivities } from '../lib/strava.server';
import 'mapbox-gl/dist/mapbox-gl.css';
const activities = await loadActivities();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Activities</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body>
  <main id="map" aria-label="Activity route map"></main>
  <p id="map-status" role="status">{activities.features.length ? '' : 'No activity data.'}</p>
  <noscript><p class="notice">Enable JavaScript to view the map.</p></noscript>
  <script id="activity-data" type="application/json" set:html={JSON.stringify(activities).replace(/</g, '\\u003c')} />
</body>
</html>
<script>
import mapboxgl from 'mapbox-gl';
import type { FeatureCollection, LineString } from 'geojson';
import type { Activity } from '../lib/strava.server';
const data = JSON.parse(document.querySelector('#activity-data')!.textContent!) as FeatureCollection<LineString, Activity>;
const status = document.querySelector<HTMLElement>('#map-status')!;
const token = import.meta.env.PUBLIC_MAPBOX_ACCESS_TOKEN;
const style = import.meta.env.PUBLIC_MAPBOX_STYLE || 'mapbox://styles/mapbox/light-v11';
if (!token) {
  status.textContent = data.features.length ? 'Map unavailable.' : 'No activity data.';
} else {
  try {
    const map = new mapboxgl.Map({ container: 'map', accessToken: token, style, center: [0, 25], zoom: 1.3, projection: 'mercator', attributionControl: true });
    let hovered: number | undefined, selected: number | undefined;
    let popup: mapboxgl.Popup | undefined;
    function state(id: number | undefined, key: string, value: boolean) {
      if (id !== undefined) map.setFeatureState({ source: 'activities', id }, { [key]: value });
    }
    function clearSelection() { state(selected, 'selected', false); selected = undefined; popup?.remove(); popup = undefined; }
    map.on('error', () => { status.textContent = 'Map unavailable.'; });
    map.on('load', () => {
      status.textContent = data.features.length ? '' : 'No activity data.';
      if (!import.meta.env.PUBLIC_MAPBOX_STYLE) {
        for (const layer of map.getStyle().layers || []) {
          if (layer.id.includes('poi') || layer.id.includes('transit')) map.setLayoutProperty(layer.id, 'visibility', 'none');
        }
      }
      map.addSource('activities', { type: 'geojson', data });
      const emphasized: mapboxgl.ExpressionSpecification = ['any', ['boolean', ['feature-state', 'hover'], false], ['boolean', ['feature-state', 'selected'], false]];
      map.addLayer({ id: 'routes', type: 'line', source: 'activities', layout: { 'line-join': 'round', 'line-cap': 'round' }, paint: {
        'line-color': '#FC4C02',
        'line-opacity': ['case', emphasized, 0.95, 0.62],
        'line-width': ['interpolate', ['linear'], ['zoom'], 0, ['case', emphasized, 1.5, 0.8], 12, ['case', emphasized, 2.6, 1.6], 18, ['case', emphasized, 3.8, 2.7]],
      } });
      map.addLayer({ id: 'route-hit', type: 'line', source: 'activities', paint: { 'line-width': 12, 'line-opacity': 0 } });
      const bounds = new mapboxgl.LngLatBounds();
      for (const feature of data.features) for (const [lng, lat] of feature.geometry.coordinates) bounds.extend([lng, lat]);
      if (!bounds.isEmpty()) map.fitBounds(bounds, { padding: 45, maxZoom: 13, duration: 0 });
      map.on('mousemove', 'route-hit', e => {
        state(hovered, 'hover', false); hovered = Number(e.features?.[0]?.id);
        state(hovered, 'hover', true); map.getCanvas().style.cursor = 'pointer';
      });
      map.on('mouseleave', 'route-hit', () => { state(hovered, 'hover', false); hovered = undefined; map.getCanvas().style.cursor = ''; });
      map.on('click', e => {
        const feature = map.queryRenderedFeatures(e.point, { layers: ['route-hit'] })[0];
        clearSelection();
        if (!feature) return;
        selected = Number(feature.id); state(selected, 'selected', true);
        const p = feature.properties!;
        const card = document.createElement('div'); card.className = 'activity-card';
        function row(tag: string, text: string) { const node = document.createElement(tag); node.textContent = text; card.append(node); }
        const seconds = Math.round(Number(p.movingTime));
        const duration = seconds >= 3600 ? `${Math.floor(seconds / 3600)}:${String(Math.floor(seconds / 60) % 60).padStart(2, '0')}:${String(seconds % 60).padStart(2, '0')}` : `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, '0')}`;
        row('h1', p.name);
        row('p', `${new Date(p.startDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })} · ${p.sportType}`);
        row('p', `${(Number(p.distance) / 1000).toFixed(1)} km    ${duration}`);
        if (['Run', 'TrailRun', 'VirtualRun', 'Walk', 'Hike'].includes(p.sportType) && Number(p.distance) > 0 && seconds > 0) {
          const pace = Math.round(seconds / (Number(p.distance) / 1000));
          row('p', `${Math.floor(pace / 60)}:${String(pace % 60).padStart(2, '0')} /km`);
        }
        const link = document.createElement('a'); link.href = `https://www.strava.com/activities/${selected}`; link.textContent = 'View on Strava ↗'; link.target = '_blank'; link.rel = 'noopener noreferrer'; card.append(link);
        popup = new mapboxgl.Popup({ closeButton: true, closeOnClick: false, maxWidth: '240px', offset: 8 }).setLngLat(e.lngLat).setDOMContent(card).addTo(map);
        popup.on('close', () => { state(selected, 'selected', false); selected = undefined; });
      });
    });
    document.addEventListener('keydown', e => { if (e.key === 'Escape') clearSelection(); });
  } catch { status.textContent = 'Map unavailable.'; }
}
</script>
<style is:global>
  html,body{margin:0;width:100%;height:100%;background:#f6f5f1;color:#252522;color-scheme:light}
  #map{width:100vw;height:100vh;height:100dvh}
  #map-status,.notice{position:fixed;top:18px;left:20px;margin:0;font:12px/1.5 system-ui,sans-serif;color:#706f68;pointer-events:none}
  #map-status:empty{display:none}
  .mapboxgl-popup-content{background:#f6f5f1;border:1px solid #dcdad2;border-radius:0;padding:14px 26px 14px 14px;box-shadow:0 2px 10px #0001;max-width:calc(100vw - 64px)}
  .mapboxgl-popup-tip{display:none}
  .activity-card{font:12px/1.5 system-ui,sans-serif;overflow-wrap:anywhere}
  .activity-card h1{font-size:13px;font-weight:500;margin:0 0 5px}
  .activity-card p{margin:4px 0;white-space:pre-wrap;color:#706f68}
  .activity-card a{display:inline-block;margin-top:8px;color:#252522;text-decoration:none}
  .activity-card a:focus-visible,.mapboxgl-popup-close-button:focus-visible{outline:2px solid #252522;outline-offset:3px}
  .mapboxgl-popup-close-button{font-size:18px;color:#706f68;padding:3px 7px}
</style>
