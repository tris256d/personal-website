---
import Layout from '../layouts/Layout.astro';
import { notes } from '../lib/notes';
---
<Layout><section class="home"><p class="eyebrow">A personal space on the internet</p><h1>Making things.<br />Keeping notes.<br /><span>Figuring it out.</span></h1><p class="intro">I'm Tristan. This is a home for projects, passing thoughts, and things that deserve a little more time.</p><a class="text-link" href="/about">A little about me <span>↗</span></a></section><section class="home-bottom"><div><p class="eyebrow">In progress</p><a href="/projects">A website to call home <span class="arrow">↗</span></a><p class="muted small">Small by design. Open to what comes next.</p></div><div><p class="eyebrow">Latest note</p><a href={'/notes/'+notes[0].slug}>{notes[0].title} <span class="arrow">↗</span></a><p class="muted small">{notes[0].date.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric',timeZone:'UTC'})}</p></div></section><a class="quiet-link" href="/now">The current snapshot →</a></Layout>
